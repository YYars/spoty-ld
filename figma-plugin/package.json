{
  "name": "spotify-playlist-figma",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "bun run lint && bun run build:code && bun run build:ui",
    "build:code": "bun build src/code.ts --outfile dist/code.js --target browser",
    "build:ui": "cp src/ui.html dist/ui.html",
    "watch": "bun build src/code.ts --outfile dist/code.js --target browser --watch",
    "dev": "bun run build && echo 'Plugin built! Import manifest.json in Figma'",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.98.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.0"
  }
}
